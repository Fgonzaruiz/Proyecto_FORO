<?xml version="1.0" encoding="UTF-8"?>
<mybb>
  <templates>
    <template name="newthread" version="1823" sid="1">
      <![CDATA[
<html>
<head>
<title>{$foruminfo['name']} - Crear Nuevo Tema</title>
{$headerinclude}
</head>
<body>
{$header}

<div class="rpg-full-form-container">
    <div class="rpg-full-form-header">
        <h1><i class="fas fa-pen-nib"></i> Crear Nuevo Tema</h1>
        <p>en {$foruminfo['name']}</p>
    </div>
    <form action="newthread.php" method="post" enctype="multipart/form-data" id="post_form" name="input">
        <input type="hidden" name="action" value="do_newthread" />
        <input type="hidden" name="fid" value="{$fid}" />
        <input type="hidden" name="my_post_key" value="{$mybb->post_code}" />
        <input type="hidden" name="subject" value="" />
        
        <div class="rpg-full-form-body">
            <div class="rpg-form-group">
                <label class="rpg-form-label" for="subject"><i class="fas fa-heading"></i> Título del Tema</label>
                <input type="text" class="rpg-form-input" name="subject" id="subject" placeholder="Escribe un título claro y descriptivo..." />
            </div>

            <div style="display:flex; gap:20px; margin-bottom:16px; flex-wrap:wrap;">
                <div style="flex:1; min-width:180px;">
                    <label class="rpg-form-label" for="game_thread_type"><i class="fas fa-tag"></i> Tipo de Rol</label>
                    <select name="game_thread_type" id="game_thread_type" class="rpg-form-input">
                        <option value="Presente">Presente</option>
                        <option value="Pasado">Pasado</option>
                        <option value="Mision">Misión</option>
                        <option value="Evento">Evento</option>
                        <option value="Trama">Trama</option>
                        <option value="Fic">Fic</option>
                    </select>
                </div>
                <div style="flex:2; min-width:200px;">
                    <label class="rpg-form-label"><i class="fas fa-calendar-alt"></i> Fecha en el Rol</label>
                    <div style="display:flex; gap:10px;">
                        <div style="flex:1;">
                            <input type="number" name="game_day" id="game_day" class="rpg-form-input" min="1" max="100" placeholder="Día">
                        </div>
                        <div style="flex:1;">
                            <select name="game_season" id="game_season" class="rpg-form-input">
                                <option value="0">Primavera</option>
                                <option value="1">Verano</option>
                                <option value="2">Otoño</option>
                                <option value="3">Invierno</option>
                            </select>
                        </div>
                        <div style="flex:1;">
                            <input type="number" name="game_year" id="game_year" class="rpg-form-input" min="1" placeholder="Año">
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="rpg-form-group">
                <label class="rpg-form-label" for="message"><i class="fas fa-align-left"></i> Contenido</label>
                {$codebuttons}
                <textarea name="message" id="message" class="rpg-editor-textarea" rows="16" placeholder="Escribe aquí el contenido de tu tema...">{$message}</textarea>
            </div>
            
            {$attachmentbox}
            {$postoptions}
        </div>
        
        <div class="rpg-form-footer">
            <a href="forumdisplay.php?fid={$fid}" class="rpg-action-btn rpg-btn-secondary"><i class="fas fa-times"></i> Cancelar</a>
            <button type="submit" class="rpg-action-btn rpg-btn-primary"><i class="fas fa-paper-plane"></i> Publicar Tema</button>
        </div>
    </form>
</div>

<script>
(function() {
    var epoch = new Date('2026-05-01T00:00:00Z').getTime();
    var now = Date.now();
    var diffDays = Math.max(0, Math.floor((now - epoch) / 86400000));
    var rolDays = (diffDays * 2) + 1;
    var year = Math.floor((rolDays - 1) / 400) + 1;
    var dayOfYear = ((rolDays - 1) % 400) + 1;
    var seasonIdx = Math.floor((dayOfYear - 1) / 100);
    var day = ((dayOfYear - 1) % 100) + 1;
    document.getElementById('game_day').value = day;
    document.getElementById('game_season').value = seasonIdx;
    document.getElementById('game_year').value = year;
})();
</script>

{$footer}
</body>
</html>
      ]]>
    </template>
  </templates>
</mybb>
