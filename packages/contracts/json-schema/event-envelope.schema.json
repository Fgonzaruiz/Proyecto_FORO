{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "source", "version", "payload"],
  "properties": {
    "event_id": { "type": "string", "minLength": 8 },
    "event_type": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "enum": ["mybb"] },
    "version": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "object",
      "properties": {
        "uid": { "type": "integer", "minimum": 0 },
        "username": { "type": "string" }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "properties": {
        "forum_id": { "type": "integer", "minimum": 0 },
        "thread_id": { "type": "integer", "minimum": 0 },
        "post_id": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "payload": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}

